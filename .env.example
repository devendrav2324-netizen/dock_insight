# =============================================================================
# Charter-AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---------- Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=charter_ai
POSTGRES_USER=charter_ai
POSTGRES_PASSWORD=changeme_in_production

# Full connection string (constructed from above, or override directly)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SIH_DEMO_MODE=True

# ---------- Paths ----------
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
TRAINED_MODELS_DIR=./trained_models

# ---------- ML ----------
MODEL_VERSION=v0.1.0
FORECAST_DEFAULT_HORIZON_DAYS=30

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- Frontend (used by React/Vite) ----------
VITE_API_BASE_URL=http://localhost:8000/api
